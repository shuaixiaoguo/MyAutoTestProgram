  <!-- 6. 信号槽连接 -->
  <section>
    <h2><span class="num">6</span>信号槽连接规划</h2>

    <figure class="diagram">
      <pre class="mermaid">
graph LR
    subgraph ICDTree["① IcdTreeViewDock"]
        T1[icdNodeSelected 信号]
    end

    subgraph ToolBox["② ControlToolBoxDock"]
        T2[controlDragStarted 信号]
    end

    subgraph Property["③ PropertyPanelDock"]
        T3[propertyChanged 信号]
    end

    subgraph Canvas["⑥ CanvasTabWidget"]
        C1[panelChanged 信号]
        C2[windowChanged 信号]
    end

    subgraph FindResult["④ FindResultDock"]
        F1[resultSelected 信号]
    end

    subgraph RunLog["⑤ RunLogDock"]
        R1[appendLog 方法]
    end

    subgraph StatusBar["⑦ StatusBar"]
        S1[updateStatus 方法]
    end

    T1 -->|选中节点→加载属性| Property
    T2 -->|拖拽控件→画布| Canvas
    T1 -->|选中节点→画布加载| Canvas
    C2 -->|选中窗体→属性面板| Property
    F1 -->|选中结果→属性面板| Property
    T3 -->|属性变更→画布更新| Canvas

    MainWindow -->|onNewPanel→newPanel| Canvas
    MainWindow -->|onNewWindow→newWindow| Canvas
    MainWindow -->|onStartTest→日志输出| RunLog
    MainWindow -->|onStartTest→状态更新| StatusBar
      </pre>
      <figcaption>图 6-1：信号槽连接关系</figcaption>
    </figure>

    <h3>核心连接代码（initConnections 方法）</h3>
    <pre><code>void MainWindow::initConnections()
{
    // ① ICD树选中 → ③ 属性面板加载属性
    connect(m_icdTreeViewDock, &IcdTreeViewDock::icdNodeSelected,
            m_propertyPanelDock, &PropertyPanelDock::setTargetObject);

    // ② 控件拖拽 → ⑥ 画布接收
    connect(m_controlToolBoxDock, &ControlToolBoxDock::controlDragStarted,
            m_canvasTab, [this](const QString &type){
        // 在当前 MdiArea 创建新控件
        // 后续实现
    });

    // ⑥ 画布窗体切换 → ③ 属性面板更新
    connect(m_canvasTab, &CanvasTabWidget::windowChanged,
            m_propertyPanelDock, &PropertyPanelDock::setTargetObject);

    // ④ 查找结果选中 → ③ 属性面板
    connect(m_findResultDock, &FindResultDock::resultSelected,
            m_propertyPanelDock, [this](const QVariantMap &data){
        // 加载查找结果到属性面板
    });

    // 菜单动作连接
    connect(m_actNewPanel, &QAction::triggered, this, &MainWindow::onNewPanel);
    connect(m_actNewWindow, &QAction::triggered, this, &MainWindow::onNewWindow);
    connect(m_actStartTest, &QAction::triggered, this, &MainWindow::onStartTest);
    connect(m_actStopTest, &QAction::triggered, this, &MainWindow::onStopTest);
    connect(m_actParamConfig, &QAction::triggered, this, &MainWindow::onParamConfig);
}</code></pre>
  </section>

  <!-- 7. QToolBox分组设计 -->
  <section>
    <h2><span class="num">7</span>QToolBox 控件分组设计</h2>

    <p>左侧②控件工具箱使用 <code>QToolBox</code> 分组展示可拖拽控件，参考 AddIn_BusRobot 的 <code>Exp_AddInPad</code>。</p>

    <div class="table-wrap">
      <table>
        <thead><tr><th>分组</th><th>控件项</th><th>拖拽后行为</th></tr></thead>
        <tbody>
          <tr>
            <td><strong>基础控件</strong></td>
            <td>开始节点、结束节点、条件分支、循环节点、延时节点</td>
            <td>在画布创建对应流程节点 Item</td>
          </tr>
          <tr>
            <td><strong>指令控件</strong></td>
            <td>发送命令、读取数据、写寄存器、读寄存器、等待响应</td>
            <td>在画布创建指令节点 Item</td>
          </tr>
          <tr>
            <td><strong>数据块控件</strong></td>
            <td>模拟量输入、数字量输入、模拟量输出、数字量输出、通讯参数</td>
            <td>在画布创建数据块配置窗体</td>
          </tr>
          <tr>
            <td><strong>判读控件</strong></td>
            <td>阈值判读、范围判读、趋势判读、逻辑组合</td>
            <td>在画布创建判读节点 Item</td>
          </tr>
          <tr>
            <td><strong>显示控件</strong></td>
            <td>数值显示、状态指示、曲线图、表格</td>
            <td>在画布创建显示控件 Item</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h4>拖拽实现思路</h4>
    <pre><code>// 每个 ToolBox 页面内的控件项继承自 QLabel，支持鼠标拖拽
class DraggableLabel : public QLabel
{
    Q_OBJECT
public:
    DraggableLabel(const QString &text, const QString &dragType, QWidget *parent = nullptr)
        : QLabel(text, parent), m_dragType(dragType)
    {
        setAlignment(Qt::AlignCenter);
        setCursor(Qt::PointingHandCursor);
        setStyleSheet("QLabel { padding: 4px; border: 1px solid #ddd; "
                       "border-radius: 4px; background: #f8f9fb; }"
                       "QLabel:hover { background: #eff6ff; border-color: #2563eb; }");
    }
protected:
    void mousePressEvent(QMouseEvent *event) override
    {
        if (event->button() == Qt::LeftButton) {
            QDrag *drag = new QDrag(this);
            QMimeData *mimeData = new QMimeData;
            mimeData->setText(m_dragType);  // 传递控件类型标识
            drag->setMimeData(mimeData);
            // 设置拖拽预览图标
            QPixmap pixmap(size());
            render(&pixmap);
            drag->setPixmap(pixmap);
            drag->setHotSpot(event->pos());
            drag->exec(Qt::CopyAction);
        }
        QLabel::mousePressEvent(event);
    }
private:
    QString m_dragType;  // 控件类型标识，如 "start_node", "send_cmd" 等
};</code></pre>
  </section>

  <!-- 8. 布局保存与恢复 -->
  <section>
    <h2><span class="num">8</span>布局保存与恢复</h2>
    <p>参考 AddIn_BusRobot 的 <code>closeEvent</code> 和 <code>Load()</code> 中的布局保存恢复机制。</p>

    <h4>保存布局（closeEvent）</h4>
    <pre><code>void MainWindow::closeEvent(QCloseEvent *event)
{
    QSettings settings("AgentFlow", "TestConfig");
    settings.setValue("windowState", saveState());     // 保存Dock布局
    settings.setValue("geometry", saveGeometry());     // 保存窗口大小位置

    // 保存各Dock显示状态
    settings.setValue("IcdTreeViewDock",   m_icdTreeViewDock->isVisible());
    settings.setValue("ControlToolBoxDock", m_controlToolBoxDock->isVisible());
    settings.setValue("PropertyPanelDock",  m_propertyPanelDock->isVisible());
    settings.setValue("FindResultDock",    m_findResultDock->isVisible());
    settings.setValue("RunLogDock",         m_runLogDock->isVisible());

    // 保存当前选中的面板索引
    settings.setValue("CurrentPanelIndex", m_canvasTab->currentIndex());

    event->accept();
}</code></pre>

    <h4>恢复布局（restoreLayout）</h4>
    <pre><code>void MainWindow::restoreLayout()
{
    QSettings settings("AgentFlow", "TestConfig");
    restoreGeometry(settings.value("geometry").toByteArray());
    restoreState(settings.value("windowState").toByteArray());

    // 恢复各Dock显示状态
    m_icdTreeViewDock->setVisible(settings.value("IcdTreeViewDock", true).toBool());
    m_controlToolBoxDock->setVisible(settings.value("ControlToolBoxDock", true).toBool());
    m_propertyPanelDock->setVisible(settings.value("PropertyPanelDock", true).toBool());
    m_findResultDock->setVisible(settings.value("FindResultDock", true).toBool());
    m_runLogDock->setVisible(settings.value("RunLogDock", true).toBool());

    // 恢复面板索引
    int index = settings.value("CurrentPanelIndex", 0).toInt();
    if (index >= 0 && index &lt; m_canvasTab->count())
        m_canvasTab->setCurrentIndex(index);
}</code></pre>
  </section>

