│
├── DockWidgets/                  # 各停靠面板
│   ├── icdtreeviewdock.h         # ① ICD接口数据库树
│   ├── icdtreeviewdock.cpp
│   ├── controltoolboxdock.h      # ② 控件工具箱
│   ├── controltoolboxdock.cpp
│   ├── propertypaneldock.h       # ③ 属性编辑面板
│   ├── propertypaneldock.cpp
│   ├── findresultdock.h          # ④ 参数查找结果
│   ├── findresultdock.cpp
│   ├── runlogdock.h              # ⑤ 运行日志输出
│   └── runlogdock.cpp
│
├── Database/                     # 数据库层
│   ├── dbmanager.h                # 数据库管理器（连接管理）
│   ├── dbmanager.cpp
│   ├── paramdatabase.h            # 参数配置数据库操作（7张表CRUD）
│   ├── paramdatabase.cpp
│   ├── projectmanager.h           # 工程管理
│   └── projectmanager.cpp
│
├── Dialogs/                      # 对话框
│   ├── newprojectdialog.h         # 新建工程对话框
│   ├── newprojectdialog.cpp
│   ├── modifyprojectdialog.h      # 修改工程对话框
│   ├── modifyprojectdialog.cpp
│   ├── databasesettingsdialog.h   # 数据库设置对话框
│   └── databasesettingsdialog.cpp
│
├── ParamConfig/                  # 参数配置对话框模块
│   ├── paramconfigdialog.h       # 参数配置主对话框（QSplitter嵌套布局）
│   ├── paramconfigdialog.cpp
│   ├── paramtree.h               # 参数树（QTreeView + QStandardItemModel，7级层级）
│   ├── paramtree.cpp
│   ├── nodepropertypanel.h       # 非参数节点属性面板（QTableWidget两列）
│   ├── nodepropertypanel.cpp
│   ├── parampropertypanel.h      # 参数级详细属性面板
│   └── parampropertypanel.cpp
│
├── CentralWidget/               # 中央画布区
│   ├── canvastabwidget.h         # ⑥ QTabWidget + QMdiArea
│   ├── canvastabwidget.cpp
│   ├── mymdisubwindow.h          # 自定义MDI子窗口
│   └── mymdisubwindow.cpp
│
├── StatusBar/                    # 状态栏
│   ├── statusbar.h               # ⑦ 自定义状态栏
│   └── statusbar.cpp
│
├── Common/                       # 公共组件
│   ├── basetreeview.h             # 基础树视图
│   ├── basetreeview.cpp
│   ├── basetableview.h            # 基础表格视图
│   ├── basetableview.cpp
│   ├── dragwidget.h               # 可拖拽控件基类
│   ├── dragwidget.cpp
│   └── commondef.h                # 公共定义、枚举、宏
│
├── Resources/                    # 资源文件
│   ├── icons/                     # 图标（SVG扁平风格，7个节点图标）
│   └── styles.qss                 # QSS样式表</code></pre>
  </section>

  <!-- 4. 类设计 -->
  <section>
    <h2><span class="num">4</span>核心类设计</h2>

    <h3>4.1 MainWindow 主窗口</h3>
    <pre><code>#ifndef MAINWINDOW_H
#define MAINWINDOW_H

#include &lt;QMainWindow&gt;
#include &lt;QDockWidget&gt;
#include &lt;QTabWidget&gt;
#include &lt;QAction&gt;

class IcdTreeViewDock;
class ControlToolBoxDock;
class PropertyPanelDock;
class FindResultDock;
class RunLogDock;
class CanvasTabWidget;
class StatusBar;

class MainWindow : public QMainWindow
{
    Q_OBJECT
public:
    explicit MainWindow(QWidget *parent = nullptr);
    ~MainWindow();

private:
    // 初始化
    void initUi();           // 创建所有 DockWidget 和中央区域
    void initMenuBar();      // 创建菜单栏
    void initToolBar();      // 创建工具栏
    void initStatusBar();    // 创建状态栏
    void initDockWidgets();  // 创建并布局所有 DockWidget
    void initConnections();  // 建立信号槽连接
    void restoreLayout();    // 恢复上次保存的布局状态

    // DockWidget 指针
    IcdTreeViewDock     *m_icdTreeViewDock;     // ①
    ControlToolBoxDock  *m_controlToolBoxDock;   // ②
    PropertyPanelDock   *m_propertyPanelDock;    // ③
    FindResultDock      *m_findResultDock;       // ④
    RunLogDock          *m_runLogDock;           // ⑤

    // 中央区域
    CanvasTabWidget *m_canvasTab;                // ⑥

    // 状态栏
    StatusBar *m_statusBar;                      // ⑦

    // 菜单动作
    QAction *m_actNewPanel;     // 新建面板
    QAction *m_actNewWindow;   // 新建窗口
    QAction *m_actStartTest;   // 开始测试
    QAction *m_actStopTest;    // 停止测试
    QAction *m_actParamConfig; // 参数配置

protected:
    void closeEvent(QCloseEvent *event) override;

private slots:
    void onNewPanel();       // 新建面板
    void onNewWindow();     // 新建窗口
    void onStartTest();     // 开始测试
    void onStopTest();      // 停止测试
    void onParamConfig();   // 参数配置
};

#endif // MAINWINDOW_H</code></pre>

    <h3>4.2 各 DockWidget 类</h3>

    <h4>① IcdTreeViewDock — ICD接口数据库树</h4>
    <pre><code>class IcdTreeViewDock : public QDockWidget
{
    Q_OBJECT
public:
    explicit IcdTreeViewDock(QWidget *parent = nullptr);
private:
    QTreeWidget *m_tree;  // ICD树形视图
    void initTree();      // 初始化树结构
private slots:
    void onTreeItemClicked(QTreeWidgetItem *item, int column);
    void onTreeItemDoubleClicked(QTreeWidgetItem *item, int column);
signals:
    void icdNodeSelected(const QString &nodeId, const QString &nodeType);
};</code></pre>

    <h4>② ControlToolBoxDock — 控件工具箱</h4>
    <pre><code>class ControlToolBoxDock : public QDockWidget
{
    Q_OBJECT
public:
    explicit ControlToolBoxDock(QWidget *parent = nullptr);
private:
    QToolBox *m_toolBox;  // 分组工具箱
    void initToolBox();   // 创建各分组控件
    void addGroup(const QString &title, const QStringList &items);
private slots:
    void onItemDragRequested(const QString &itemType);
signals:
    void controlDragStarted(const QString &controlType);
};</code></pre>

    <h4>③ PropertyPanelDock — 属性编辑面板</h4>
    <pre><code>class PropertyPanelDock : public QDockWidget
{
    Q_OBJECT
public:
    explicit PropertyPanelDock(QWidget *parent = nullptr);
    void setTargetObject(QObject *obj);  // 绑定目标对象
    void clear();                        // 清空属性面板
private:
    QScrollArea *m_scrollArea;
    QFormLayout *m_formLayout;
    QWidget *m_contentWidget;
    QObject *m_currentTarget;
    void buildPropertyFields(QObject *obj);
private slots:
    void onPropertyChanged(const QString &propName, const QVariant &value);
signals:
    void propertyChanged(const QString &propName, const QVariant &value);
};</code></pre>

    <h4>④ FindResultDock — 参数查找结果</h4>
    <pre><code>class FindResultDock : public QDockWidget
{
    Q_OBJECT
public:
    explicit FindResultDock(QWidget *parent = nullptr);
    void setResults(const QList&lt;QVariantMap&gt; &results);
    void clearResults();
private:
    QTableWidget *m_table;
    void initTable();
private slots:
    void onResultItemClicked(int row, int col);
signals:
    void resultSelected(const QVariantMap &itemData);
};</code></pre>

    <h4>⑤ RunLogDock — 运行日志输出</h4>
    <pre><code>class RunLogDock : public QDockWidget
{
    Q_OBJECT
public:
    explicit RunLogDock(QWidget *parent = nullptr);
    void appendLog(int level, const QString &message);
    void clearLog();

private:
    QTextEdit *m_logEdit;
    QTimer *m_flushTimer;          // 定时刷新定时器
    QQueue&lt;QPair&lt;int,QString&gt;&gt; m_msgQueue;  // 消息队列
    QMutex m_queueMutex;           // 队列锁
    static const int MAX_LOG_LINES = 5000;  // 最大日志行数

    void initUi();
    void flushQueue();             // 刷新队列消息到TextEdit
private slots:
    void onFlushTimeout();         // 定时刷新槽
};</code></pre>

    <div class="callout">
      <strong>日志消息队列设计（仿 BusRobot）：</strong>
    所有日志先写入 <code>m_msgQueue</code> 队列（加锁），
    <code>m_flushTimer</code> 每 100ms 触发一次 <code>onFlushTimeout()</code>，
    批量从队列取出消息写入 <code>QTextEdit</code>，避免高频日志导致 UI 卡顿。
    超过 <code>MAX_LOG_LINES</code> 行时自动删除最早日志。
    </div>

    <h3>4.3 CanvasTabWidget — 中央画布区</h3>
    <pre><code>class CanvasTabWidget : public QTabWidget
{
    Q_OBJECT
public:
    explicit CanvasTabWidget(QWidget *parent = nullptr);

    void newPanel(const QString &name = QString());  // 新建面板(Tab)
    void deletePanel(int index = -1);                 // 删除面板
    void newWindow();                                 // 在当前面板新建MDI子窗口
    void deleteWindow();                              // 删除当前MDI子窗口
    void autoLayout();                               // 自动平铺布局
    void cascadeLayout();                             // 层叠布局

    QMdiArea* currentMdiArea();                       // 获取当前Tab的MdiArea
    int panelCount() const;

private:
    void initUi();
    int m_panelCounter;  // 面板编号计数器

private slots:
    void onTabChanged(int index);
    void onTabCloseRequested(int index);

signals:
    void panelChanged(int index);
    void windowChanged(QMdiSubWindow *window);
};</code></pre>

    <h3>4.4 StatusBar — 状态栏</h3>
    <pre><code>class StatusBar : public QStatusBar
{
    Q_OBJECT
public:
    explicit StatusBar(QWidget *parent = nullptr);
    void updateStatus(const QStringList &status);  // 更新状态
    void setMessage(const QString &msg);            // 更新临时消息

private:
    QLabel *m_msgLabel;  // 左侧消息标签 ("就绪"等)
    QPushButton *m_btnAgent;   // Agent状态按钮
    QPushButton *m_btnDB;      // 数据库状态按钮
    QPushButton *m_btnServer;  // 服务器状态按钮
    QPushButton *m_btnMode;    // 运行模式按钮

    void initUi();
    void updateButtonIcon(QPushButton *btn, const QString &iconPath, const QString &tooltip);

private slots:
    void onButtonPressed();  // 按钮按下时在消息区显示tooltip
};</code></pre>
  </section>

  <!-- 5. 菜单栏与工具栏 -->
  <section>
    <h2><span class="num">5</span>菜单栏与工具栏</h2>

    <h3>5.1 菜单栏结构</h3>
