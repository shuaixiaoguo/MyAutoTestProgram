    background: var(--bg2); border: 1px solid var(--rule); border-radius: 8px; padding: 1.1rem; margin-bottom: 1rem;
  }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin: 1rem 0; }
