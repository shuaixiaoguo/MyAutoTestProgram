      <div class="wf-status">
        <span class="wf-item accent">● 就绪</span>
        <span class="wf-item muted">Agent: 正常</span>
        <span class="wf-item muted">DB: 已连接</span>
        <span class="wf-item muted">Server: 运行中</span>
      </div>
